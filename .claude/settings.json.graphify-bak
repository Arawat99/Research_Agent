{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:11434",
    "ANTHROPIC_AUTH_TOKEN": "ollama-local",
    "ANTHROPIC_MODEL": "gpt-oss:120b-cloud"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(cat *)"
    ]
  },
  "file_access": {
    "allow": [
      "Read",
      "Edit"
    ],
    "deny": [
      "Delete",
      "env"
    ]
  }
}